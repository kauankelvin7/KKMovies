# KauanFlix Environment Variables

# TMDB API Configuration
# Get your API key at: https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=9c67da6981361febeb1f5be860b5df6c
VITE_TMDB_BASE_URL=https://api.themoviedb.org/3
VITE_TMDB_IMAGE_URL=https://image.tmdb.org/t/p

# Backend API URL (for development)
VITE_API_URL=https://kk-movies-phi.vercel.app/

# 111movies streaming base
VITE_111movies_BASE=https://111movies.net

# TMDB Embed API (optional - enables native streaming player with 13+ sources)
# Leave empty to disable. Deploy from: https://github.com/typical-GO/tmdb-embed-api
VITE_TMDB_EMBED_API_URL=
